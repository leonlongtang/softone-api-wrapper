# SoftOne WS wrapper runtime configuration
# Copy this file to `.env` and fill values.
# IMPORTANT: do not commit `.env` if it contains real credentials.

# Use mock backend (local sqlite + mock_ws.py)
# true/1/yes = mock mode, no live SoftOne connection needed
SOFTONE_MOCK=true

# Base URL for real SoftOne WS calls
# Example: https://demo.oncloud.gr/s1services
SOFTONE_BASE_URL=

# Web Account credentials (Web Accounts -> username/password) + AppID
SOFTONE_USERNAME=
SOFTONE_PASSWORD=
SOFTONE_APP_ID=

ANTHROPIC_API_KEY=

CLAUDE_MODEL=
CLAUDE_FALLBACK_MODEL=

# Ollama server (read natively by the ollama client); default http://127.0.0.1:11434
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_MCP_DEBUG=
